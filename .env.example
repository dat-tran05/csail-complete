# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=csail-dev-password

# AWS Bedrock — required by the chat agent (frontend/app/api/chat/agent.ts).
# These are read by @anthropic-ai/bedrock-sdk via the standard AWS credential chain.
# You can omit them here if you have ~/.aws/credentials or an IAM role configured.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only if using temporary STS credentials
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional: Semantic Scholar API key (raises rate limits during enrichment)
SEMANTIC_SCHOLAR_API_KEY=
